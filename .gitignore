# Historical local probes and recovery utilities stay in the private workspace.
tooling/*
!tooling/build_mixer_model.py
!tooling/generate_public_icon.py
!tooling/audit_public_tree.ps1
!tooling/stage_public_source.ps1

# OBJ files are private by default; explicitly authored public fixtures may be
