* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.patch text eol=lf
# Public release manifests hash exact staged bytes. Keep Windows scripts and
# plain-text metadata byte-for-byte in Git archives instead of normalizing
# their line endings inside Git objects.
.gitattributes -text
.gitignore -text
LICENSE -text
*.ps1 -text
*.cmd -text
*.txt -text
*.spec -text
*.npz binary
*.sqlite binary
*.ico binary
*.png binary
*.obj text eol=lf
