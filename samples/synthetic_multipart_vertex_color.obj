# Synthetic multipart vertex-color OBJ
# Purpose: public-domain import, part-routing, color, and watertightness fixture
# Units: millimetres
# License: CC0-1.0; see LICENSE.txt
# Vertex format: v x y z r g b (RGB values are normalized to 0..1)

o Calibration_Base
g calibration_base
v -24.000000 -16.000000 0.000000 0.080000 0.160000 0.300000
v 24.000000 -16.000000 0.000000 0.120000 0.280000 0.520000
v 24.000000 16.000000 0.000000 0.160000 0.420000 0.620000
v -24.000000 16.000000 0.000000 0.120000 0.260000 0.460000
v -24.000000 -16.000000 6.000000 0.340000 0.500000 0.720000
v 24.000000 -16.000000 6.000000 0.420000 0.680000 0.820000
v 24.000000 16.000000 6.000000 0.560000 0.820000 0.880000
v -24.000000 16.000000 6.000000 0.400000 0.620000 0.780000
s off
f 1 3 2
f 1 4 3
f 5 6 7
f 5 7 8
f 1 2 6
f 1 6 5
f 2 3 7
f 2 7 6
f 3 4 8
f 3 8 7
f 4 1 5
f 4 5 8

o Gradient_Octahedron
