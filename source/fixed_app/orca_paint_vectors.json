  "specification": {
    "state_numbering": "Raw Orca EnforcerBlockerType: NONE=0, Extruder1=1, ..., Extruder255=255.",
    "node_nibble": "Bits 0..1 are split_sides. A nonzero value 1..3 is an internal node with split_sides+1 children; bits 2..3 hold special_side. For split_sides=3, special_side must be zero.",
    "leaf_nibble": "A zero split_sides field is a leaf. Nibbles 0,4,8 encode states 0,1,2. Nibble C starts an extended state.",
    "extended_state": "After C, each F contributes 15 and the first non-F nibble contributes 0..14; decoded state is 3 + 15*count(F) + final_nibble.",
    "child_order": "The in-memory children are child0..childN. Orca serializes them childN..child0 after the parent nibble.",
    "hex_order": "get_triangle_as_string prepends each logical nibble. Therefore the XML string is the reverse of the logical root-first nibble stream, using uppercase hexadecimal.",
    "valid_state_range": [0, 255]
  },
