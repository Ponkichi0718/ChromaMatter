  "known_gaps": [
    {
      "id": "pillow-wheel-native-closure-unfixed",
      "blocks_release": true,
      "affected_components": ["Pillow", "FreeType", "HarfBuzz", "libjpeg", "Little CMS", "libpng", "libtiff", "libwebp", "libsharpyuv", "OpenJPEG", "Brotli", "Xau", "XCB", "zlib-ng", "XZ"],
      "observed_dependency_versions": {
        "Brotli": "1.1.0",
        "FreeType": "2.13.3",
        "HarfBuzz": "11.0.1",
        "libjpeg-turbo": "3.1.0",
        "Little CMS": "2.17",
        "libpng": "1.6.47",
        "libtiff": "4.7.0",
        "libwebp": "1.5.0",
        "libXau": "1.0.12",
        "libxcb": "1.17.0",
        "OpenJPEG": "2.5.3",
        "XZ": "5.8.1",
        "zlib-ng": "2.2.4"
      },
      "reason": "PyPI provenance binds the wheel hash to the Pillow 11.2.1 tag, and the dependency script records version labels, but that script consumes a moving pillow-depends-main.zip payload and does not hash-bind every dependency source/archive used for the 17 bundled dylibs.",
      "required_resolution": "Recover the exact pillow-depends payload and bind every bundled dylib to hash-fixed source and license bytes, or controlled-rebuild Pillow from a fully hash-locked dependency set."
    },
    {
      "id": "pymeshlab-build-provenance-unfixed",
      "blocks_release": true,
      "affected_components": ["PyMeshLab", "MeshLab", "pybind11", "VCGLib", "Qt", "Homebrew-provided build dependencies"],
      "reason": "The official release workflow checks out main after an automated version commit, installs unpinned Homebrew packages, and uses a cache key that is not commit-bound; the exact published wheel build inputs therefore are not reproducible from the tag alone.",
      "required_resolution": "Obtain the upstream build logs/cache/source identities for the locked wheel or controlled-rebuild an equivalent wheel from fully fixed inputs."
    },
    {
      "id": "pymeshlab-third-party-native-closure-unfixed",
      "blocks_release": true,
      "affected_components": ["lib3mf", "Boost", "Embree", "GLEW", "FreeType", "GMP", "MPFR", "GLib", "gettext", "JPEG", "XZ", "md4c", "OpenMP", "PCRE2", "PNG", "oneTBB", "TIFF", "WebP", "libsharpyuv", "Xerces-C", "zstd", "U3D"],
      "reason": "Mach-O filenames and load commands expose part of the closure, but exact source revisions and published-wheel binary pairing are not fixed for every carried component. The wheel's WebP dylibs also load libsharpyuv from the separately packaged Pillow closure, so cross-group dependency pairing must be retained.",
      "required_resolution": "Produce a complete component map from the exact wheel, bind every native binary to source/license material, and validate the reconstructed closure."
    },
    {
      "id": "pymeshlab-qt-relink-route-unverified",
      "blocks_release": true,
      "affected_components": ["Qt 5.15.18 shared frameworks and plugins"],
      "reason": "Qt version evidence and an exact source archive are known, but the replacement/re-sign/relink procedure has not been exercised against the distributed app bundle.",
      "required_resolution": "Document and test replacement or relinking with a modified Qt build, including ad-hoc re-signing and launch verification."
    },
    {
