{
  "schema_version": 1,
  "bundle_id": "chromamatter-windows-corresponding-source",
  "bundle_status": "candidate-only-not-release-approved",
  "release_approval": {
    "status": "release-approved",
    "requires_all_known_gaps_resolved": true,
    "required_gap_ids": [
      "pytetwild-nanobind-exact-build-version",
      "meshlab-md5-only-external-archives"
    ]
  },
  "default_external_archive_lock": "meshlab_windows_external_archives.lock.json",
