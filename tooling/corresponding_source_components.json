    "nanobind_required_gitlinks": [
      {
        "path": "ext/robin_map",
        "url": "https://github.com/Tessil/robin-map.git"
      }
    ],
    "required_for_staging": true
  },
  "allowed_redirect_host_suffixes": [
    "download.qt.io",
    "qt.io",
    "github.com",
    "githubusercontent.com",
    "gitlab.com",
