    "destination": "components/ChromaMatter"
  },
  "known_gaps": [
    {
      "id": "pytetwild-nanobind-exact-build-version",
      "status": "unresolved",
      "reason": "PyTetWild 0.3.0 declares nanobind >=1.3.2 without an exact build lock; recover the exact wheel-build version before release approval",
      "resolution_evidence": {
        "kind": "pytetwild-controlled-rebuild"
      }
    },
    {
      "id": "meshlab-md5-only-external-archives",
      "status": "unresolved",
      "reason": "Other MeshLab external archives are verified against hashes from the exact CMake commit, but those upstream pins are MD5; release review should preserve the generated SHA-256 values in a final lock",
      "resolution_evidence": {
        "kind": "complete-dynamic-archive-sha256-lock",
        "rule_id": "meshlab-windows-external-build-inputs"
      }
    }
  ],
  "pytetwild_rebuild_policy": {
    "component": "pytetwild-0.3.0",
    "known_gap_id": "pytetwild-nanobind-exact-build-version",
    "template": "pytetwild_rebuild_lock.template.json",
